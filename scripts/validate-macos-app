#!/bin/bash
set -euo pipefail

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
app=${1:?Usage: validate-macos-app /path/to/Glassmacs.app}
app=$(CDPATH='' cd -- "$app" && pwd)
contents="$app/Contents"
plist="$contents/Info.plist"
bootstrap="$contents/MacOS/GlassmacsBootstrap"
emacs="$contents/MacOS/Emacs"
plutil=${GLASSMACS_PLUTIL:-/usr/bin/plutil}
plist_buddy=${GLASSMACS_PLISTBUDDY:-/usr/libexec/PlistBuddy}

test -f "$plist"
test -x "$bootstrap"
test -x "$emacs"
test -f "$contents/Resources/Glassmacs/init.el"
test -f "$contents/Resources/Glassmacs/lisp/glassmacs.el"
test -f "$contents/Resources/Glassmacs/scripts/bootstrap"
test -f "$contents/Resources/Glassmacs/macos/libglassmacs-lifecycle.dylib"
test -f "$contents/Resources/Glassmacs.icns"
/usr/bin/env "$plutil" -lint "$plist"
test "$(/usr/bin/env "$plist_buddy" -c 'Print :CFBundlePackageType' "$plist")" = APPL
test "$(/usr/bin/env "$plist_buddy" -c 'Print :CFBundleIdentifier' "$plist")" = org.glassmacs.Glassmacs
test "$(/usr/bin/env "$plist_buddy" -c 'Print :CFBundleExecutable' "$plist")" = GlassmacsBootstrap
test "$(/usr/bin/env "$plist_buddy" -c 'Print :CFBundleIconFile' "$plist")" = Glassmacs
test "$(/usr/bin/env "$plist_buddy" -c 'Print :LSMinimumSystemVersion' "$plist")" = 13.0

for extension in R r Rmd qmd Rnw; do
  /usr/bin/env "$plist_buddy" -c 'Print :CFBundleDocumentTypes:0:CFBundleTypeExtensions' \
    "$plist" | grep -Eq "^[[:space:]]*${extension}[[:space:]]*$"
done

GLASSMACS_OTOOL=${GLASSMACS_OTOOL:-/usr/bin/otool} \
python3 - "$contents" "$emacs" "$root/scripts" <<'PY'
import os
from pathlib import Path
import re
import sys

sys.path.insert(0, sys.argv[3])
from macos_macho import (
    discover_macho_binaries,
    is_within_bundle,
    parse_otool_dependencies,
    run_tool,
)

contents = Path(sys.argv[1]).resolve()
main_executable = Path(sys.argv[2]).resolve()
otool = os.environ["GLASSMACS_OTOOL"]
system_prefixes = (
    "/System/Library/",
    "/System/Volumes/Preboot/Cryptexes/OS/System/Library/",
    "/usr/lib/",
    "/Library/Apple/System/Library/",
)
bare_tokens = {"@rpath", "@loader_path", "@executable_path"}

def output(*arguments):
    try:
        return run_tool(
            otool, *arguments[1:],
            context=f"inspect Mach-O load commands for {arguments[-1]}",
        )
    except RuntimeError as error:
        sys.exit(str(error))

def within_bundle(path):
    return is_within_bundle(path, contents)

def runtime_path_allowed(path, binary):
    if path in bare_tokens:
        return True
    if path.startswith("@loader_path/"):
        resolved = binary.parent / path[len("@loader_path/"):]
    elif path.startswith("@executable_path/"):
        resolved = main_executable.parent / path[len("@executable_path/"):]
    elif path.startswith("/"):
        if path.startswith(system_prefixes):
            return True
        resolved = Path(path)
    else:
        return False
    return within_bundle(resolved)

def rpaths_for(binary):
    lines = output("/usr/bin/otool", "-l", str(binary)).splitlines()
    paths = []
    for index, line in enumerate(lines):
        if line.strip() == "cmd LC_RPATH" and index + 2 < len(lines):
            match = re.match(r"\s*path (.+?) \(offset \d+\)", lines[index + 2])
            if match:
                paths.append(match.group(1))
    return paths

def expand_runtime_path(path, binary, rpaths):
    if path in bare_tokens:
        return []
    if path.startswith("@loader_path/"):
        return [binary.parent / path[len("@loader_path/"):]]
    if path.startswith("@executable_path/"):
        return [main_executable.parent / path[len("@executable_path/"):]]
    if path.startswith("@rpath/"):
        suffix = path[len("@rpath/"):]
        return [
            candidate / suffix
            for rpath in rpaths
            for candidate in expand_runtime_path(rpath, binary, ())
        ]
    if path.startswith("/") and not path.startswith(system_prefixes):
        return [Path(path)]
    return []

def dependency_resolves(candidate):
    try:
        resolved = candidate.resolve(strict=True)
    except OSError:
        return False
    return within_bundle(resolved) or str(resolved).startswith(system_prefixes)

def own_install_name(binary):
    lines = output("/usr/bin/otool", "-D", str(binary)).splitlines()
    return lines[1].strip() if len(lines) > 1 else None

try:
    binaries = discover_macho_binaries(contents)
except RuntimeError as error:
    sys.exit(str(error))

if main_executable not in binaries:
    sys.exit(f"Expected Emacs Mach-O executable was not found: {main_executable}")

for binary_index, binary in enumerate(binaries, start=1):
    if binary_index == 1 or binary_index % 100 == 0 or binary_index == len(binaries):
        print(
            f"Inspecting Mach-O dependencies {binary_index}/{len(binaries)}: {binary}",
            flush=True,
        )
    rpaths = rpaths_for(binary)
    for rpath in rpaths:
        if not runtime_path_allowed(rpath, binary):
            sys.exit(f"Unexpected or non-relocatable LC_RPATH in {binary}: {rpath}")

    try:
        dependencies = parse_otool_dependencies(
            output("/usr/bin/otool", "-L", str(binary))
        )
    except RuntimeError as error:
        sys.exit(f"Could not parse dependencies in {binary}: {error}")
    install_name = own_install_name(binary)
    for dependency in dependencies:
        if dependency in {str(binary), install_name}:
            continue
        if dependency.startswith(system_prefixes):
            continue
        candidates = expand_runtime_path(dependency, binary, rpaths)
        if not candidates or not any(dependency_resolves(candidate) for candidate in candidates):
            sys.exit(f"Unresolved or non-relocatable dependency in {binary}: {dependency}")

init_file = contents / "Resources/Glassmacs/init.el"
startup = init_file.read_text()
policy = re.search(
    r"^\(glassmacs--configure-native-compilation\)$",
    startup,
    re.MULTILINE,
)
glassmacs_load = startup.find("(require 'glassmacs)")
if not policy or glassmacs_load < 0 or policy.start() > glassmacs_load:
    sys.exit("Native-compilation policy must run before Glassmacs package initialization")
if 'GLASSMACS_NATIVE_COMP' not in startup or 'native-comp-jit-compilation' not in startup:
    sys.exit("Bundled startup does not configure native JIT compilation")

print(f"Checked {len(binaries)} bundled Mach-O files and startup policy")
PY
if [ "${GLASSMACS_SKIP_EMACS_STARTUP:-0}" != 1 ]; then
  "$emacs" -Q --batch --eval '(princ emacs-version)' >/dev/null
fi

printf 'Validated Glassmacs.app structure and direct executable dependencies: %s\n' "$app"
