#!/bin/bash
set -euo pipefail

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
app=${1:?Usage: validate-macos-app /path/to/Glassmacs.app}
app=$(CDPATH='' cd -- "$app" && pwd)
contents="$app/Contents"
plist="$contents/Info.plist"
bootstrap="$contents/MacOS/GlassmacsBootstrap"
emacs="$contents/MacOS/Emacs"
plutil=${GLASSMACS_PLUTIL:-/usr/bin/plutil}
plist_buddy=${GLASSMACS_PLISTBUDDY:-/usr/libexec/PlistBuddy}

test -f "$plist"
test -x "$bootstrap"
test -x "$emacs"
test -f "$contents/Resources/Glassmacs/init.el"
test -f "$contents/Resources/Glassmacs/lisp/glassmacs.el"
test -f "$contents/Resources/Glassmacs/scripts/bootstrap"
test -f "$contents/Resources/Glassmacs/macos/libglassmacs-lifecycle.dylib"
test -f "$contents/Resources/Glassmacs.icns"
/usr/bin/env "$plutil" -lint "$plist"
test "$(/usr/bin/env "$plist_buddy" -c 'Print :CFBundlePackageType' "$plist")" = APPL
test "$(/usr/bin/env "$plist_buddy" -c 'Print :CFBundleIdentifier' "$plist")" = org.glassmacs.Glassmacs
test "$(/usr/bin/env "$plist_buddy" -c 'Print :CFBundleExecutable' "$plist")" = GlassmacsBootstrap
test "$(/usr/bin/env "$plist_buddy" -c 'Print :CFBundleIconFile' "$plist")" = Glassmacs
test "$(/usr/bin/env "$plist_buddy" -c 'Print :LSMinimumSystemVersion' "$plist")" = 13.0


# Static packaged-app checks (acceptance matrix DIST-001 to DIST-004,
# ASSOC-001): document types, architectures, build-machine references,
# permissions and the code signature.  Mach-O headers are read directly,
# so the checks run with mocked tools on Linux too.
GLASSMACS_REQUIRED_ARCHITECTURES=${GLASSMACS_REQUIRED_ARCHITECTURES:-arm64 x86_64} \
python3 - "$contents" "$root" <<'PY'
import os
import plistlib
import stat
import sys
from pathlib import Path

contents = Path(sys.argv[1]).resolve()
root = Path(sys.argv[2]).resolve()
sys.path.insert(0, str(root / "scripts"))
from macos_macho import discover_macho_binaries, macho_architectures

def fail(message):
    sys.exit(f"Packaged-app check failed: {message}")

# Every document type Glassmacs declares must survive the Info.plist merge,
# and only one instance may run, so Finder opens reach the running app.
bundle_plist = plistlib.loads((contents / "Info.plist").read_bytes())
source_plist = plistlib.loads((root / "macos/Info.plist").read_bytes())
declared = {extension for entry in bundle_plist.get("CFBundleDocumentTypes", [])
            for extension in entry.get("CFBundleTypeExtensions", [])}
expected = {extension for entry in source_plist.get("CFBundleDocumentTypes", [])
            for extension in entry.get("CFBundleTypeExtensions", [])}
if expected - declared:
    fail(f"document types missing from Info.plist: {sorted(expected - declared)}")
if bundle_plist.get("LSMultipleInstancesProhibited") is not True:
    fail("LSMultipleInstancesProhibited must be true so documents open in the running app")

# Glassmacs's own binaries and Emacs must contain every supported architecture.
required = set(os.environ["GLASSMACS_REQUIRED_ARCHITECTURES"].split())
own = [contents / "MacOS/GlassmacsBootstrap",
       contents / "Resources/Glassmacs/macos/libglassmacs-lifecycle.dylib"]
for binary in own + [contents / "MacOS/Emacs"]:
    try:
        architectures = macho_architectures(binary)
    except RuntimeError as error:
        fail(str(error))
    if required - architectures:
        fail(f"{binary.relative_to(contents)} lacks {sorted(required - architectures)} "
             f"(has {sorted(architectures)})")

binaries = discover_macho_binaries(contents, progress_interval=0)
counts = {}
for binary in binaries:
    key = " ".join(sorted(macho_architectures(binary)))
    counts[key] = counts.get(key, 0) + 1
print("Mach-O architectures: " + "; ".join(f"{k}: {v}" for k, v in sorted(counts.items())))

# Build-machine references.  Runtime linkage outside the bundle is
# rejected by the dependency check above.  Here, fail on references that
# tie the app to one machine: its own location (not relocatable) anywhere,
# or this build's checkout or temporary directories inside the binaries
# Glassmacs compiles.  Upstream binaries legitimately embed build paths in
# strings (libgccjit's /nix/store gcc driver paths, used only for
# just-in-time native compilation, which Glassmacs disables), so prefixes
# such as /nix/store, /opt/homebrew and /usr/local are counted, not failed.
app_path = str(contents.parent).encode()
build_paths = [str(root).encode(), b"/tmp/glassmacs-build.", b"/private/tmp/glassmacs-build."]
if os.environ.get("RUNNER_TEMP"):
    build_paths.append(os.environ["RUNNER_TEMP"].encode())
informational = [b"/nix/store/", b"/opt/homebrew/", b"/usr/local/", b"/Users/"]
reported = {prefix: 0 for prefix in informational}
own_resolved = {path.resolve() for path in own}
for binary in binaries:
    data = binary.read_bytes()
    if app_path in data:
        fail(f"{binary.relative_to(contents)} refers to the app's own location {app_path.decode()}")
    if binary in own_resolved:
        for path in build_paths:
            if path in data:
                fail(f"{binary.relative_to(contents)} refers to the build machine path {path.decode()}")
    for prefix in informational:
        if prefix in data:
            reported[prefix] += 1
print("Mach-O files mentioning absolute prefixes (informational): "
      + ", ".join(f"{p.decode()} {n}" for p, n in reported.items()))

# Permissions: nothing world-writable or set-id; executables executable.
for directory, directories, files in os.walk(contents.parent):
    for name in directories + files:
        path = Path(directory) / name
        mode = path.lstat().st_mode
        if stat.S_ISLNK(mode):
            continue
        if mode & stat.S_IWOTH:
            fail(f"world-writable: {path.relative_to(contents.parent)}")
        if mode & (stat.S_ISUID | stat.S_ISGID):
            fail(f"set-user or set-group ID: {path.relative_to(contents.parent)}")
for path in (contents / "MacOS").iterdir():
    if path.resolve() in set(binaries) and not os.access(path, os.X_OK):
        fail(f"not executable: {path.relative_to(contents)}")
print(f"Checked document types, architectures ({' '.join(sorted(required))}), "
      f"build-machine references and permissions")
PY

codesign=${GLASSMACS_CODESIGN:-/usr/bin/codesign}
if ! /usr/bin/env "$codesign" --verify --deep --strict "$app"; then
  printf 'Packaged-app check failed: the code signature does not verify: %s\n' "$app" >&2
  exit 1
fi

GLASSMACS_OTOOL=${GLASSMACS_OTOOL:-/usr/bin/otool} \
python3 - "$contents" "$emacs" "$root/scripts" <<'PY'
import os
from pathlib import Path
import re
import sys

sys.path.insert(0, sys.argv[3])
from macos_macho import (
    discover_macho_binaries,
    is_within_bundle,
    parse_otool_dependencies,
    run_tool,
)

contents = Path(sys.argv[1]).resolve()
main_executable = Path(sys.argv[2]).resolve()
otool = os.environ["GLASSMACS_OTOOL"]
system_prefixes = (
    "/System/Library/",
    "/System/Volumes/Preboot/Cryptexes/OS/System/Library/",
    "/usr/lib/",
    "/Library/Apple/System/Library/",
)
bare_tokens = {"@rpath", "@loader_path", "@executable_path"}

def output(*arguments):
    try:
        return run_tool(
            otool, *arguments[1:],
            context=f"inspect Mach-O load commands for {arguments[-1]}",
        )
    except RuntimeError as error:
        sys.exit(str(error))

def within_bundle(path):
    return is_within_bundle(path, contents)

def runtime_path_allowed(path, binary):
    if path in bare_tokens:
        return True
    if path.startswith("@loader_path/"):
        resolved = binary.parent / path[len("@loader_path/"):]
    elif path.startswith("@executable_path/"):
        resolved = main_executable.parent / path[len("@executable_path/"):]
    elif path.startswith("/"):
        if path.startswith(system_prefixes):
            return True
        resolved = Path(path)
    else:
        return False
    return within_bundle(resolved)

def rpaths_for(binary):
    lines = output("/usr/bin/otool", "-l", str(binary)).splitlines()
    paths = []
    for index, line in enumerate(lines):
        if line.strip() == "cmd LC_RPATH" and index + 2 < len(lines):
            match = re.match(r"\s*path (.+?) \(offset \d+\)", lines[index + 2])
            if match:
                paths.append(match.group(1))
    return paths

def expand_runtime_path(path, binary, rpaths):
    if path in bare_tokens:
        return []
    if path.startswith("@loader_path/"):
        return [binary.parent / path[len("@loader_path/"):]]
    if path.startswith("@executable_path/"):
        return [main_executable.parent / path[len("@executable_path/"):]]
    if path.startswith("@rpath/"):
        suffix = path[len("@rpath/"):]
        return [
            candidate / suffix
            for rpath in rpaths
            for candidate in expand_runtime_path(rpath, binary, ())
        ]
    if path.startswith("/") and not path.startswith(system_prefixes):
        return [Path(path)]
    return []

def dependency_resolves(candidate):
    try:
        resolved = candidate.resolve(strict=True)
    except OSError:
        return False
    return within_bundle(resolved) or str(resolved).startswith(system_prefixes)

def own_install_name(binary):
    lines = output("/usr/bin/otool", "-D", str(binary)).splitlines()
    return lines[1].strip() if len(lines) > 1 else None

try:
    binaries = discover_macho_binaries(contents)
except RuntimeError as error:
    sys.exit(str(error))

if main_executable not in binaries:
    sys.exit(f"Expected Emacs Mach-O executable was not found: {main_executable}")

for binary_index, binary in enumerate(binaries, start=1):
    if binary_index == 1 or binary_index % 100 == 0 or binary_index == len(binaries):
        print(
            f"Inspecting Mach-O dependencies {binary_index}/{len(binaries)}: {binary}",
            flush=True,
        )
    rpaths = rpaths_for(binary)
    for rpath in rpaths:
        if not runtime_path_allowed(rpath, binary):
            sys.exit(f"Unexpected or non-relocatable LC_RPATH in {binary}: {rpath}")

    try:
        dependencies = parse_otool_dependencies(
            output("/usr/bin/otool", "-L", str(binary))
        )
    except RuntimeError as error:
        sys.exit(f"Could not parse dependencies in {binary}: {error}")
    install_name = own_install_name(binary)
    for dependency in dependencies:
        if dependency in {str(binary), install_name}:
            continue
        if dependency.startswith(system_prefixes):
            continue
        candidates = expand_runtime_path(dependency, binary, rpaths)
        if not candidates or not any(dependency_resolves(candidate) for candidate in candidates):
            sys.exit(f"Unresolved or non-relocatable dependency in {binary}: {dependency}")

init_file = contents / "Resources/Glassmacs/init.el"
startup = init_file.read_text()
policy = re.search(
    r"^\(glassmacs--configure-native-compilation\)$",
    startup,
    re.MULTILINE,
)
glassmacs_load = startup.find("(require 'glassmacs)")
if not policy or glassmacs_load < 0 or policy.start() > glassmacs_load:
    sys.exit("Native-compilation policy must run before Glassmacs package initialization")
for setting in (
    "native-comp-jit-compilation",
    "native-comp-enable-subr-trampolines",
    "native-comp-eln-load-path",
):
    if setting not in startup:
        sys.exit(f"Bundled startup does not configure native-compilation setting: {setting}")
if "GLASSMACS_NATIVE_COMP" in startup:
    sys.exit("Bundled startup must not expose an unsafe native-compilation opt-in")

print(f"Checked {len(binaries)} bundled Mach-O files and startup policy")
PY
if [ "${GLASSMACS_SKIP_EMACS_STARTUP:-0}" != 1 ]; then
  "$emacs" -Q --batch --eval '(princ emacs-version)' >/dev/null
fi

printf 'Validated Glassmacs.app structure and direct executable dependencies: %s\n' "$app"
