#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
emacs_command=${GLASSMACS_EMACS:-emacs}
if ! emacs=$(command -v "$emacs_command" 2>/dev/null); then
  printf "Glassmacs: GNU Emacs executable '%s' was not found. Install GNU Emacs and ensure 'emacs' is on PATH, or set GLASSMACS_EMACS to its executable.\n" \
    "$emacs_command" >&2
  exit 127
fi

# Give Emacs the Glassmacs home as its user directory from the start, as the
# app does; otherwise interactive startup creates an empty ~/.emacs.d.
# The default must match `glassmacs-home' in lisp/glassmacs-core.el, where an
# empty GLASSMACS_HOME also means the default.
home=${GLASSMACS_HOME:-}
[ -n "$home" ] || home="$HOME/.config/glassmacs"
mkdir -p -- "$home"
exec "$emacs" -Q --init-directory="$home" --load "$root/init.el" "$@"
