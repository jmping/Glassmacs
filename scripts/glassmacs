#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
emacs_command=${GLASSMACS_EMACS:-emacs}
if ! emacs=$(command -v "$emacs_command" 2>/dev/null); then
  printf "Glassmacs: GNU Emacs executable '%s' was not found. Install GNU Emacs and ensure 'emacs' is on PATH, or set GLASSMACS_EMACS to its executable.\n" \
    "$emacs_command" >&2
  exit 127
fi

exec "$emacs" -Q --load "$root/init.el" "$@"
