#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

# Inside Glassmacs.app this script lives in Contents/Resources/Glassmacs.
# Default to the bundled Emacs and to the app's own home, the same
# directory GlassmacsBootstrap gives the running app, so packages land where
# the app looks for them.  Explicit GLASSMACS_EMACS / GLASSMACS_HOME win.
case "$root" in
  */Contents/Resources/Glassmacs)
    bundled_emacs="${root%/Resources/Glassmacs}/MacOS/Emacs"
    : "${GLASSMACS_EMACS:=$bundled_emacs}"
    : "${GLASSMACS_HOME:=$HOME/Library/Application Support/Glassmacs}"
    export GLASSMACS_HOME
    ;;
esac

emacs_command=${GLASSMACS_EMACS:-emacs}
if ! emacs=$(command -v "$emacs_command" 2>/dev/null); then
  printf "Glassmacs bootstrap: GNU Emacs executable '%s' was not found. Install GNU Emacs and ensure 'emacs' is on PATH, or set GLASSMACS_EMACS to its executable.\n" \
    "$emacs_command" >&2
  exit 127
fi

# The package list and installation logic live in lisp/glassmacs-packages.el
# (`glassmacs-install-optional-packages'), shared with the in-app menu
# command.  Each package installs independently; failures are reported
# together and make this script exit with a nonzero status.
exec "$emacs" -Q --batch --load "$root/init.el" \
  --eval '(glassmacs-install-optional-packages t)'
