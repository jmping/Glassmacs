#!/usr/bin/env python3
"""Check registered document identity, metadata and repository-relative links."""
import re
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
REGISTRY = ROOT / "docs/registry.toml"
META = re.compile(r"^> \*\*Document ID:\*\*\s*(DOC-[A-Z0-9-]+)", re.M)
LINK = re.compile(r"(?<!!)\[[^\]]+\]\(([^)]+)\)")


def check():
    with REGISTRY.open("rb") as stream:
        docs = tomllib.load(stream)["document"]
    errors = []
    ids, paths = set(), set()
    for doc in docs:
        ident, name = doc["id"], doc["path"]
        if ident in ids:
            errors.append(f"duplicate document ID: {ident}")
        if name in paths:
            errors.append(f"duplicate document path: {name}")
        ids.add(ident)
        paths.add(name)
        target = (ROOT / name).resolve()
        if not target.is_relative_to(ROOT.resolve()) or not target.is_file():
            errors.append(f"{ident}: missing or invalid path {name}")
            continue
        content = target.read_text()
        found = META.search(content)
        if not found or found.group(1) != ident:
            errors.append(f"{name}: expected metadata Document ID {ident}")
        for link in LINK.findall(content):
            if link.startswith(("http:", "https:", "mailto:", "#")):
                continue
            relative = link.split("#", 1)[0].split("?", 1)[0]
            if not relative:
                continue
            linked = (target.parent / relative).resolve()
            if not linked.is_relative_to(ROOT.resolve()) or not linked.exists():
                errors.append(f"{name}: broken link {link}")
    return errors


if __name__ == "__main__":
    issues = check()
    for issue in issues:
        print(issue, file=sys.stderr)
    if issues:
        sys.exit(1)
    print("Documentation registry and registered links: OK")
