const title = 'Glassmacs — Documentation Provenance';
const labels = [
['AI-generated','The substantive prose was generated primarily by AI with little or no material human rewriting. A person may still have selected, reviewed, or published it.'],
['AI-generated, human-edited','AI produced the main draft and a person materially revised the wording, structure, or substance.'],
['Iterative human–AI construction','The ideas and prose emerged through repeated back-and-forth between a person and AI systems. Neither side is a useful sole author of the final artifact. This is the default label for the current Glassmacs website.'],
['Human-generated, AI-edited','A person supplied the substantive draft and AI materially reorganized, polished, or expanded it.'],
['Human-generated','The substantive text was written by a person without generative-AI drafting or editing.']
];
