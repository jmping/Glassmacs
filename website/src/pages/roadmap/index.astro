const title = 'Glassmacs feature and parity roadmap';
const groups = [
{heading:'Integrated foundations',status:'Implemented; automated coverage varies',items:['Upstream Cocoa GNU Emacs with a thin Glassmacs configuration and native bootstrap','Mac-oriented document opening, windows, keyboard profiles, menus and appearance preferences','Native unsaved-document review, quit safety, recovery snapshots and workspace restoration','R/ESS source and console workflows, R toolbar actions, and contextual commands','R Markdown, Quarto, Sweave, LaTeX and mixed-document editing integrations','Packaged-app CI, ERT, ESS/R integration, and GUI acceptance for selected workflows']},
{heading:'Before beta: verification and parity',status:'Active validation, not blanket parity',items:['Finish dynamic menu shortcut labels and their native GUI acceptance (PR #91)','Audit Aquamacs menu inventory and historical regressions against current Glassmacs behavior','Exercise clean-machine installation, Finder and Dock behavior, signing, notarization and Gatekeeper','Verify R sessions, graphics, help windows, console switching, and multi-window document behavior by hand','Check optional ESS availability and packaging on machines without user-installed packages (PR #56 is a prerequisite, not bundling itself)','Verify the full supported macOS and architecture matrix, including Intel and Apple Silicon','Review accessibility, performance, crash recovery, data-loss scenarios and test-harness reliability']},
{heading:'Aquamacs parity: deliberately selective',status:'Compare behavior, not marketing checkboxes',items:['Preserve the practical Mac document and shortcut experience without promising every Aquamacs customization','Review per-document windows, buffer/window navigation, menus, preferences and modes against Aquamacs','Record missing or different behavior as issues with evidence and explicit priority','Favor upstream GNU Emacs and maintained packages rather than duplicating legacy implementations']},
{heading:'After beta: connected research workflows',status:'Exploratory; not committed release features',items:['SSH and TRAMP-centered remote editing and execution','Git integration, potentially including richer project history and review workflows','Docker or other containers as reproducible execution environments','Jupyter kernels and notebook-oriented workflows','Project-aware connections, execution targets and session management where justified by real use cases']}
];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Glassmacs implemented features, Aquamacs parity work, beta verification, and post-beta roadmap."/><title>{title}</title><link rel="icon" href="/favicon.svg"/><style>:root{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color-scheme:light dark}body{margin:0;background:#f6f8fc;color:#182b42;line-height:1.65}header,main,footer{max-width:960px;margin:auto;padding:20px 26px}header{display:flex;justify-content:space-between;gap:20px}a{color:#25628c}h1{font-size:clamp(2.5rem,6vw,4rem);line-height:1.1;letter-spacing:-.05em}h2{margin-bottom:6px}p.lead{font-size:1.18rem;color:#586b7f;max-width:760px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin:38px 0}.card{border:1px solid #dce5ef;background:white;border-radius:16px;padding:24px}.tag{font-size:.85rem;color:#25628c;font-weight:700}li{margin:9px 0}footer{border-top:1px solid #dce5ef;margin-top:60px}@media(max-width:720px){.grid{grid-template-columns:1fr}}@media(prefers-color-scheme:dark){body{background:#101b2a;color:#ecf3fb}.card{background:#172638;border-color:#31455c}.tag,a{color:#8ec9f0}p.lead{color:#b1c1d2}}</style></head><body><header><a href="/">← Glassmacs</a><nav><a href="/story/">Our story</a> · <a href="https://github.com/jmping/Glassmacs/issues">Issues</a></nav></header><main><p class="tag">Public development roadmap · November 2026</p><h1>Feature coverage and the road ahead</h1><p class="lead">Glassmacs is experimental. “Implemented” means code exists; it does not imply release-quality behavior on every machine. Passing automated tests and clean-machine validation are different milestones. Aquamacs parity is a goal for useful workflows, not a promise to clone every feature.</p><div class="grid">{groups.map(group => <section class="card"><div class="tag">{group.status}</div><h2>{group.heading}</h2><ul>{group.items.map(item => <li>{item}</li>)}</ul></section>)}</div><h2>How to track evidence</h2><p>The <a href="https://github.com/jmping/Glassmacs/blob/main/docs/acceptance-matrix.md">acceptance matrix</a> records implementation and verification separately, including packaged-app and clean-machine status. The <a href="https://github.com/jmping/Glassmacs/issues/94">post-beta integration roadmap</a> tracks SSH, Git, containers, and Jupyter ideas. Current pull requests and CI results are available in the <a href="https://github.com/jmping/Glassmacs">public repository</a>.</p><p>This roadmap is descriptive, not a release date or compatibility guarantee. The website and project are developed with disclosed AI coding assistance; see <a href="/story/">the origin story</a>.</p></main><footer>Glassmacs · <a href="/">Home</a></footer></body></html>