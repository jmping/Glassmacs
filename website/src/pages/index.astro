---
const title = 'Glassmacs — A modern macOS Emacs for research and writing';
const description = 'Glassmacs brings a Mac-oriented editing experience to modern GNU Emacs, with an emphasis on R, ESS, Quarto, LaTeX, and reproducible research.';
const repo = 'https://github.com/jmping/Glassmacs';
const releases = repo + '/releases';
const docs = repo + '/tree/main/docs';
const issues = repo + '/issues';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101e30" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://glassmacs.joshpasek.com/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://glassmacs.joshpasek.com/" />
    <title>{title}</title>
    <style>
      :root{color-scheme:light dark;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;--bg:#f6f8fc;--ink:#182b42;--muted:#586b7f;--card:#fff;--line:#dce5ef;--accent:#25628c;--soft:#e8f2f9}
      *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);line-height:1.65}a{color:inherit}a:focus-visible{outline:3px solid #6aaedb;outline-offset:4px} .wrap{max-width:1100px;margin:auto;padding:0 28px}
      header{position:sticky;top:0;z-index:2;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}nav{min-height:74px;display:flex;align-items:center;justify-content:space-between;gap:24px}nav .links{display:flex;gap:25px;align-items:center;font-size:.92rem}nav a{text-decoration:none}nav a:hover{text-decoration:underline}.brand{display:flex;align-items:center;gap:12px;font-weight:750;font-size:1.12rem;letter-spacing:-.03em}.brand img{width:34px;height:34px}
      .hero-logo{display:flex;align-items:center;gap:16px;margin-bottom:28px}.hero-logo img{width:84px;height:84px;border-radius:21px;box-shadow:0 12px 35px #0a21322b}.hero-logo span{font-size:1.4rem;font-weight:750;letter-spacing:-.035em}.hero{padding:110px 0 84px;display:grid;grid-template-columns:1.1fr .9fr;gap:50px;align-items:center}.eyebrow{text-transform:uppercase;letter-spacing:.15em;font-size:.75rem;font-weight:750;color:var(--accent)}h1{font-size:clamp(3rem,6vw,5.2rem);line-height:1.06;letter-spacing:-.065em;margin:17px 0 25px}h1 span{color:var(--accent)}.lead{font-size:1.22rem;color:var(--muted);max-width:610px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}.button{display:inline-block;text-decoration:none;border-radius:11px;padding:12px 20px;font-weight:650;background:var(--accent);color:white}.button.secondary{background:var(--soft);color:var(--ink);border:1px solid var(--line)}.button:hover{filter:brightness(1.08)}.status{margin-top:25px;color:var(--muted);font-size:.91rem}
      .window{border-radius:16px;overflow:hidden;border:1px solid #6c849b;box-shadow:0 26px 70px #0a21322b;background:#15283e;color:#d9e9f5;transform:rotate(1deg)}.windowbar{display:flex;align-items:center;gap:7px;padding:12px 15px;background:#25384e;border-bottom:1px solid #40556b}.dot{width:11px;height:11px;border-radius:50%;background:#ff6964}.dot:nth-child(2){background:#f5c14e}.dot:nth-child(3){background:#64c77b}.windowbar small{margin:auto;font-size:.73rem;color:#c0cedc}.editor{padding:22px 24px;font:14px/1.85 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre-wrap}.comment{color:#8da4b9}.keyword{color:#9fd3ff}.string{color:#c9e6b5}.output{color:#f4c985}.windowfoot{padding:9px 15px;background:#2e4966;font:12px ui-monospace,monospace;color:#d6e5f4}
      section{padding:75px 0;border-top:1px solid var(--line)}h2{font-size:clamp(2rem,3.5vw,3rem);line-height:1.2;letter-spacing:-.045em;margin:0 0 15px}.intro{max-width:720px;color:var(--muted);margin:0 0 34px;font-size:1.08rem}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{padding:28px;border-radius:16px;background:var(--card);border:1px solid var(--line)}.card h3{margin:0 0 10px;font-size:1.15rem}.card p{margin:0;color:var(--muted)}.label{display:inline-block;font-size:.73rem;letter-spacing:.07em;text-transform:uppercase;font-weight:700;color:var(--accent);margin-bottom:12px}.split{display:grid;grid-template-columns:1fr 1fr;gap:55px;align-items:start}.note{padding:25px 30px;background:var(--soft);border:1px solid var(--line);border-radius:15px}.note p:last-child{margin-bottom:0}footer{border-top:1px solid var(--line);padding:30px 0;color:var(--muted);font-size:.88rem}footer .wrap{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
      @media(max-width:850px){.hero,.split{grid-template-columns:1fr}.hero{padding:65px 0}.window{transform:none;max-width:640px}.grid{grid-template-columns:1fr 1fr}nav .links{gap:13px}}
      @media(max-width:580px){.wrap{padding:0 19px}.grid{grid-template-columns:1fr}nav .links a:nth-child(2),nav .links a:nth-child(3){display:none}.hero{padding:55px 0}section{padding:55px 0}.editor{font-size:12px;padding:16px}}
      @media(prefers-color-scheme:dark){:root{--bg:#101b2a;--ink:#ecf3fb;--muted:#b1c1d2;--card:#172638;--line:#31455c;--accent:#8ec9f0;--soft:#22394d}.button{background:#8ec9f0;color:#0e2438}.button.secondary{color:var(--ink)}.window{box-shadow:0 25px 70px #0005}}
      @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
    </style>
  </head>
  <body>
    <header><nav class="wrap" aria-label="Primary navigation"><a class="brand" href="#top"><img src="/favicon.svg" alt="" />Glassmacs</a><div class="links"><a href="#features">Features</a><a href="#research">Research</a><a href="#download">Download</a><a href="#development">Development</a><a href={repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></nav></header>
    <main id="top">
      <div class="wrap hero">
        <div><div class="hero-logo"><img src="/favicon.svg" alt="Glassmacs logo" width="84" height="84" /><span>Glassmacs</span></div><div class="eyebrow">Emacs, at home on your Mac</div><h1>Powerful editing.<br /><span>Mac intuition.</span></h1><p class="lead">Glassmacs combines modern GNU Emacs with a document-oriented macOS experience, built especially for R, research, and reproducible writing.</p><div class="actions"><a class="button" href="#features">Explore Glassmacs →</a><a class="button secondary" href={repo}>View source ↗</a></div><p class="status">● Experimental project · Under active development · macOS</p></div>
        <div class="window" role="img" aria-label="Illustrative code sample showing an R Markdown document. This is not an application screenshot."><div class="windowbar"><i class="dot"></i><i class="dot"></i><i class="dot"></i><small>analysis.Rmd — illustrative preview</small></div><div class="editor"><span class="comment"># A reproducible analysis</span>

<span class="comment">A document, a workspace, and R.</span>

<span class="keyword">```&#123;r summary&#125;</span>
data(cars)
fit &lt;- lm(dist ~ speed, data = cars)
summary(fit)
<span class="keyword">```</span>

<span class="comment">## Findings</span>
The estimated coefficient is
<span class="string">`r round(coef(fit)[2], 2)`</span>.

<span class="output"># R / ESS · Quarto · LaTeX</span></div><div class="windowfoot">Glassmacs  ·  R Markdown  ·  UTF-8</div></div>
      </div>
      <section id="features"><div class="wrap"><div class="label">Why Glassmacs</div><h2>Emacs flexibility. Mac familiarity.</h2><p class="intro">A contemporary Emacs foundation with thoughtful defaults for everyday macOS editing and technical work.</p><div class="grid"><article class="card"><div class="label">01 / macOS</div><h3>Document-first editing</h3><p>Designed around familiar document windows, menus, keyboard conventions, and opening files from Finder.</p></article><article class="card"><div class="label">02 / Emacs</div><h3>Modern foundations</h3><p>Built on contemporary GNU Emacs, with macOS-specific behavior kept as modular as possible.</p></article><article class="card"><div class="label">03 / Workflow</div><h3>Research ready</h3><p>R and ESS are central, alongside Quarto, R Markdown, Sweave, LaTeX, and PDF workflows.</p></article></div></div></section>
      <section id="research"><div class="wrap split"><div><div class="label">For researchers and writers</div><h2>Stay in your document. Keep your tools close.</h2><p class="intro">Move between prose, analysis, and output without abandoning the editor. Glassmacs is being developed for workflows where code and writing belong together.</p><a class="button secondary" href={docs}>Explore documentation ↗</a></div><div class="note"><h3>Designed for mixed-language documents</h3><p>Work on R Markdown, Quarto, and Sweave documents with R-aware commands, chunk navigation, and rendering integrations. Feature coverage and native macOS behavior are still being tested.</p></div></div></section>
      <section id="download"><div class="wrap split"><div><div class="label">Get Glassmacs</div><h2>Follow the builds.</h2><p class="intro">Glassmacs is experimental software. Check the releases page for available builds and installation information; do not rely on it yet for irreplaceable work without backups.</p><div class="actions"><a class="button" href={releases}>Check GitHub Releases ↗</a><a class="button secondary" href={repo}>Browse the repository ↗</a></div></div><div class="note"><h3>Development status</h3><p>Compatibility, packaging, and native macOS integration are under active validation. No signed or notarized release is implied by this site.</p></div></div></section>
      <section id="development"><div class="wrap"><div class="label">Open development</div><h2>Built in the open.</h2><p class="intro">Read the roadmap, inspect implementation decisions, report issues, and follow progress in the public repository.</p><div class="grid"><article class="card"><h3><a href={repo}>Source code ↗</a></h3><p>Browse the Glassmacs implementation and development history.</p></article><article class="card"><h3><a href={docs}>Documentation ↗</a></h3><p>Configuration notes, technical design, and compatibility work.</p></article><article class="card"><h3><a href={issues}>Issues and feedback ↗</a></h3><p>Known limitations, planned work, and bug reports.</p></article></div><p style="margin-top:30px;color:var(--muted)">Glassmacs is inspired in part by Aquamacs and is not an official Aquamacs project or successor. GNU Emacs is a separate upstream project.</p></div></section>
    </main>
    <footer><div class="wrap"><span>© {new Date().getFullYear()} Glassmacs project</span><span>Made for macOS · Powered by GNU Emacs</span></div></footer>
  </body>
</html>
